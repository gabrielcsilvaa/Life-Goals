DJANGO_SETTINGS_MODULE=config.production_settings
APP_VERSION=
DEBUG=false
SECRET_KEY=
FRONTEND_ORIGIN=https://app.example.com
ALLOWED_HOSTS=api.example.com,127.0.0.1
MCP_PUBLIC_URL=https://api.example.com/mcp
OAUTH_PUBLIC_ORIGIN=https://api.example.com
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLROOTCERT=/run/certs/postgres-ca.pem
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Runtime role: DML only. A separate migration.env uses the schema owner role.
# TLS CA must be mounted read-only at the path above when not in system trust.
