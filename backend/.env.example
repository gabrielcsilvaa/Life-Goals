DEBUG=true
SECRET_KEY=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=lifegoals
DB_USER=lifegoals
DB_PASSWORD=
# Somente ferramentas de instalação/administração local usam estes campos.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp

# O launcher start-mcp.ps1 define estes valores somente no processo público.
# Para hospedagem estável, configure a origem HTTPS e o recurso MCP correspondentes.
# OAUTH_PUBLIC_ORIGIN=https://seu-dominio.example
# MCP_PUBLIC_URL=https://seu-dominio.example/mcp
